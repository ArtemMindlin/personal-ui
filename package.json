{
  "name": "personal-ui",
  "version": "0.2.3",
  "description": "Shared design system and shell components for personal tools",
  "author": "Artem Mindlin",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./shell.css": "./dist/shell.css",
    "./components.css": "./dist/components.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node -e \"import('fs').then(fs => { for (const f of ['tokens.css', 'shell.css', 'components.css']) fs.copyFileSync('src/styles/' + f, 'dist/' + f); })\"",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0 || ^0.400.0 || ^0.500.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
